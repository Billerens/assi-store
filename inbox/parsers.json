{
  "about": "Как читать уведомления мессенджеров. Это заводской список: правки и новые мессенджеры кладите в data/inbox/parsers.json (тот же вид, запись с тем же id заменяет заводскую). Регулярные выражения — строки JavaScript без флагов, сравнение без учёта регистра. title — правила для заголовка (группа видна по нему), text — для текста («Петя: текст»), when: group — только если беседа уже известна как группа, always — всегда. hidden — текст, которым мессенджер прячет содержимое; skip — заголовки служебных уведомлений; self — как мессенджер называет владельца.",
  "parsers": [
    {
      "id": "telegram",
      "name": "Telegram",
      "packages": ["org.telegram.messenger", "org.telegram.messenger.web", "org.telegram.plus", "org.thunderdog.challegram", "nekox.messenger", "tw.nekomimi.nekogram"],
      "titleClean": ["\\s*\\(\\d+[^)]*\\)\\s*$"],
      "title": [{ "re": "^(.+?) @ (.+)$", "sender": 1, "chat": 2, "group": true }],
      "text": [{ "re": "^([^:\\n]{1,40}): ([\\s\\S]+)$", "sender": 1, "text": 2, "when": "group" }],
      "hidden": ["^(у вас )?(\\d+ )?(новое|новых|новые) сообщени\\S*( в \\d+ чат\\S*)?\\.?$", "^(you have )?(a |\\d+ )?new messages?( from \\d+ chats?)?\\.?$"],
      "skip": ["^telegram$"],
      "skipText": ["^(обновление|updating|подключение|connecting)\\S*"],
      "self": ["^(вы|you)$"]
    },
    {
      "id": "whatsapp",
      "name": "WhatsApp",
